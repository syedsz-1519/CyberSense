# LLM Provider API key (server-side only, never commit the real key)
# Free option: Groq — no credit card needed, get a key at https://console.groq.com/keys
LLM_API_KEY=

# Which provider to use: "groq" (free, no credit card) or "anthropic" (paid)
LLM_PROVIDER=groq

# Port for the Express server
PORT=5000

# URL of the Python semantic RAG microservice (see /python)
PY_RAG_URL=http://localhost:8001
